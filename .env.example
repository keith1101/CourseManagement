# Application
PORT=5001
# Comma-separated browser origins allowed to call the API.
FRONTEND_URL="http://localhost:3000"

# Email verification
EMAIL_PROVIDER="console"
EMAIL_VERIFICATION_TTL_MINUTES="1440"
EMAIL_RESEND_COOLDOWN_SECONDS="60"
EMAIL_RESEND_MAX_ATTEMPTS="5"
EMAIL_RESEND_WINDOW_MINUTES="60"
# Set EMAIL_PROVIDER="gmail" for real email delivery through Gmail API.
# These OAuth2 credentials belong to the Gmail account used as the sender.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Optional: set this only when using a matching OAuth callback/one-time token flow.
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="your-sender@gmail.com"

# PostgreSQL (replace with your own local or hosted database URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT (use a long, random secret outside source control)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Google Cloud Storage
GCP_PROJECT_ID="course-management-2026"
GCS_BUCKET_NAME="course-media-bucket"
# For local development, point this to a service-account JSON key outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS="course-media-uploader.json"

# Optional test seed (never use real credentials or production secrets here)
ALLOW_TEST_SEED="false"
SEED_ADMIN_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# Dedicated demo reset/seed guards (disabled by default)
DEMO_RESET_TARGET="local"
ALLOW_DEMO_RESET="false"
ALLOW_LOCAL_DEMO_RESET="false"
ALLOW_PRODUCTION_DEMO_RESET="false"
DEMO_ADMIN_PASSWORD=""
DEMO_FREE_STUDENT_PASSWORD=""
DEMO_PRO_STUDENT_PASSWORD=""
DEMO_LOCKED_STUDENT_PASSWORD=""

# New attempts use the server-authoritative sequential flow when enabled.
# Existing attempts retain their persisted legacy flowVersion.
SEQUENTIAL_EXAM_FLOW_ENABLED="false"

# Integration tests must use a disposable PostgreSQL database. Set
# DATABASE_URL to the same value when running Prisma migrations for that DB;
# never point TEST_DATABASE_URL at the cloud proxy or production data.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/course_management_test?schema=public"
