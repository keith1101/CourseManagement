# Application
PORT=5001

# PostgreSQL runtime connection (Neon pooled URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"
# Direct URL for Prisma migrations, dumps and other session-level operations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE_NAME?schema=public"

# JWT (use a long, random secret outside source control)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Neon Object Storage (S3-compatible, branch-scoped)
NEON_S3_BUCKET_NAME="course-media-bucket"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://<branch-endpoint>.storage.c-1.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"

# Optional test seed (never use real credentials or production secrets here)
ALLOW_TEST_SEED="false"
SEED_ADMIN_PASSWORD=""
SEED_STUDENT_PASSWORD=""
