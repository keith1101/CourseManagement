# Application
PORT=5001

# PostgreSQL (replace with your own local or hosted database URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT (use a long, random secret outside source control)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Google Cloud Storage
GCP_PROJECT_ID="course-management-2026"
GCS_BUCKET_NAME="course-media-bucket"
# For local development, point this to a service-account JSON key outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS="course-media-uploader.json"

# Optional test seed (never use real credentials or production secrets here)
ALLOW_TEST_SEED="false"
SEED_ADMIN_PASSWORD=""
SEED_STUDENT_PASSWORD=""
