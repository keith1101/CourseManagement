generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               String                   @id @default(uuid())
  fullName                         String
  email                            String                   @unique
  phone                            String?
  dateOfBirth                      DateTime?
  passwordHash                     String
  role                             UserRole                 @default(STUDENT)
  isActive                         Boolean                  @default(true)
  accessLevel                      AccessLevel              @default(FREE)
  lastLoginAt                      DateTime?
  proExpiresAt                     DateTime?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt
  tokenVersion                     Int                      @default(0)
  emailVerifiedAt                  DateTime?
  verificationEmailLastRequestedAt DateTime?
  verificationEmailWindowStartedAt DateTime?
  verificationEmailRequestCount    Int                      @default(0)
  emailVerificationTokens          EmailVerificationToken[]
  examAssignments                  ExamAssignment[]
  examAttempts                     ExamAttempt[]
  subscriptions                    Subscription[]
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model Subject {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  description  String?
  displayOrder Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  materials    Material[]
  questions    Question[]
}

model Material {
  id               String       @id @default(uuid())
  subjectId        String
  title            String
  materialType     MaterialType
  storageUrl       String?
  embedUrl         String?
  originalFileName String?
  mimeType         String?
  fileSizeBytes    Int?
  accessLevel      AccessLevel
  isPublished      Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  subject          Subject      @relation(fields: [subjectId], references: [id])
}

model Exam {
  id              String           @id @default(uuid())
  title           String
  description     String?
  status          ExamStatus       @default(DRAFT)
  accessLevel     AccessLevel      @default(FREE)
  displayOrder    Int              @default(0)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  examAssignments ExamAssignment[]
  examAttempts    ExamAttempt[]
  questions       Question[]

  @@index([deletedAt])
}

model Question {
  id                      String                    @id @default(uuid())
  examId                  String
  questionType            QuestionType
  contentText             String
  imageUrl                String?
  instruction             String?
  explaination            String?
  timeLimitSeconds        Int
  correctTextAnswer       String?
  position                Int
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  subjectId               String
  hintImageUrl            String?
  explanationImageUrl     String?
  hint                    String?
  attemptAnswers          AttemptAnswer[]
  attemptQuestionProgress AttemptQuestionProgress[]
  exam                    Exam                      @relation(fields: [examId], references: [id])
  subject                 Subject                   @relation(fields: [subjectId], references: [id])
  questionAcceptedAnswers QuestionAcceptedAnswer[]
  questionOptions         QuestionOption[]
  questionParts           QuestionPart[]

  @@index([subjectId])
}

model QuestionOption {
  id             String          @id @default(uuid())
  questionId     String
  contentText    String
  isCorrect      Boolean         @default(false)
  position       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  imageUrl       String?
  attemptAnswers AttemptAnswer[]
  question       Question        @relation(fields: [questionId], references: [id])
}

model QuestionAcceptedAnswer {
  id             String          @id @default(uuid())
  questionId     String
  answerType     AnswerValueType
  rawValue       String
  isPrimary      Boolean         @default(false)
  normalizedText String?
  content        String?
  isCorrect      Boolean         @default(false)
  position       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  numericValue   Float?
  question       Question        @relation(fields: [questionId], references: [id])
}

// A multipart short-answer question is made up of independently graded
// prompts.  The answer type is inferred from correctAnswer at grading time so
// the authoring UI only needs the prompt and its expected answer.
model QuestionPart {
  id            String              @id @default(uuid())
  questionId    String
  contentText   String
  correctAnswer String
  position      Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  question      Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswerPart[]

  @@unique([questionId, position])
  @@index([questionId])
}

model ExamAssignment {
  id           String        @id @default(uuid())
  userId       String
  examId       String
  assignedAt   DateTime      @default(now())
  dueAt        DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  exam         Exam          @relation(fields: [examId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  examAttempts ExamAttempt[]

  @@index([userId, deletedAt])
  @@index([examId, deletedAt])
}

model ExamAttempt {
  id                       String                    @id @default(uuid())
  userId                   String
  examId                   String
  assignmentId             String?
  status                   AttemptStatus             @default(IN_PROGRESS)
  submittedAt              DateTime?
  correctCount             Int                       @default(0)
  totalQuestions           Int
  startedAt                DateTime                  @default(now())
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  flowVersion              Int                       @default(1)
  progressVersion          Int                       @default(0)
  currentAttemptQuestionId String?                   @unique
  attemptedAnswers         AttemptAnswer[]
  attemptQuestionProgress  AttemptQuestionProgress[] @relation("AttemptQuestionProgress")
  assignment               ExamAssignment?           @relation(fields: [assignmentId], references: [id])
  currentAttemptQuestion   AttemptQuestionProgress?  @relation("CurrentAttemptQuestion", fields: [currentAttemptQuestionId], references: [id])
  exam                     Exam                      @relation(fields: [examId], references: [id])
  user                     User                      @relation(fields: [userId], references: [id])
}

model AttemptQuestionProgress {
  id                String                @id @default(uuid())
  attemptId         String
  questionId        String
  ordinal           Int
  timeLimitSeconds  Int
  status            AttemptQuestionStatus @default(LOCKED)
  activatedAt       DateTime?
  deadlineAt        DateTime?
  submittedAt       DateTime?
  advanceAfter      DateTime?
  completedAt       DateTime?
  isCorrect         Boolean?
  timedOut          Boolean               @default(false)
  lastAdvanceKey    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  examAttempt       ExamAttempt           @relation("AttemptQuestionProgress", fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question              @relation(fields: [questionId], references: [id])
  currentForAttempt ExamAttempt?          @relation("CurrentAttemptQuestion")

  @@unique([attemptId, questionId])
  @@unique([attemptId, ordinal])
  @@unique([attemptId, lastAdvanceKey])
  @@index([attemptId, status])
}

model AttemptAnswer {
  id               String          @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerType       AnswerValueType
  rawValue         String
  normalizedText   String?
  content          String?
  isCorrect        Boolean         @default(false)
  position         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  numericValue     Float?
  submittedAt      DateTime?
  timedOut         Boolean         @default(false)
  submissionKey    String?
  examAttempt      ExamAttempt     @relation(fields: [attemptId], references: [id])
  question         Question        @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  partAnswers      AttemptAnswerPart[]

  @@unique([attemptId, submissionKey])
  @@index([attemptId, questionId])
}

model AttemptAnswerPart {
  id              String        @id @default(uuid())
  attemptAnswerId String
  questionPartId  String
  rawValue        String
  normalizedText  String?
  numericValue    Float?
  isCorrect       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attemptAnswer   AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  questionPart    QuestionPart  @relation(fields: [questionPartId], references: [id])

  @@unique([attemptAnswerId, questionPartId])
  @@index([questionPartId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  STUDENT
}

enum AccessLevel {
  FREE
  PRO
}

enum MaterialType {
  PDF
  DOCX
  EMBEDDED_VIDEO
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  MULTI_PART_SHORT_ANSWER
}

enum AnswerValueType {
  TEXT
  NUMBER
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AttemptQuestionStatus {
  LOCKED
  ACTIVE
  CORRECT
  INCORRECT
  TIMED_OUT
  COMPLETED
}
